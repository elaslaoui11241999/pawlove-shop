<div id="productos" style="background:var(--warm)">
  <div class="sec">
    <div class="sec-lbl">Los más populares</div>
    <h2 class="sec-h">Productos que <span>encantan</span></h2>
    <div class="prod-grid">

      {% assign source = collections.all %}
      {% if section.settings.collection != blank %}
        {% assign source = collections[section.settings.collection] %}
      {% endif %}

      {% for product in source.products limit: 8 %}
        <div class="pc">
          <div class="pc-img" style="font-size:0">

            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | img_url: '500x500', crop: 'center' }}"
                alt="{{ product.featured_image.alt | escape }}"
                style="width:100%;height:100%;object-fit:cover"
                loading="lazy"
              >
            {% else %}
              <span style="font-size:64px">🛒</span>
            {% endif %}

            {% if product.compare_at_price > product.price %}
              <div class="pc-badge b-sale">Oferta</div>
            {% elsif product.created_at > 'now' | date: '%s' | minus: 2592000 %}
              <div class="pc-badge b-new">Nuevo</div>
            {% endif %}

            <button class="pc-wish" onclick="showToast('Guardado en favoritos')">🤍</button>

            <a href="{{ product.url }}" class="pc-add">
              {% if product.available %}
                🛒 Ver producto
              {% else %}
                Sin stock
              {% endif %}
            </a>

          </div>
          <div class="pc-info">
            <div class="pc-brand">{{ product.type | default: 'Producto' }}</div>
            <div class="pc-name">{{ product.title }}</div>
            <div class="pc-price">
              <span class="pp-cur">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="pp-old">{{ product.compare_at_price | money }}</span>
                {% assign saved_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="pp-save">-{{ saved_pct }}%</span>
              {% endif %}
            </div>
            {% if product.metafields.reviews.rating != blank %}
              <div class="pc-stars">★★★★★ <span>({{ product.metafields.reviews.rating_count }} reseñas)</span></div>
            {% endif %}
          </div>
        </div>
      {% else %}
        <p style="color:var(--gray);grid-column:1/-1;text-align:center;padding:40px">
          Añade productos en tu panel de Shopify para verlos aquí.
        </p>
      {% endfor %}

    </div>
    <div style="text-align:center;margin-top:44px">
      <a href="{{ routes.collections_url }}/all" class="btn btn-o">Ver todos los productos 🛒</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleccion a mostrar (opcional, por defecto todos)"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
