<div id="productos" style="background:var(--warm)">
  <div class="sec ra">
    <div class="sec-lbl">Los más populares</div>
    <h2 class="sec-h">Productos que <span>encantan</span></h2>
    <div class="prod-grid">
      {% for block in section.blocks %}
        <div class="pc" {{ block.shopify_attributes }}>
          <div class="pc-img">
            {{ block.settings.emoji }}
            {% if block.settings.badge != blank %}
              <div class="pc-badge {{ block.settings.badge_style }}">{{ block.settings.badge }}</div>
            {% endif %}
            <button class="pc-wish" onclick="showToast('Guardado en favoritos')">&#x1F90D;</button>
            <a href="{{ block.settings.url }}" class="pc-add">&#x1F43E; Añadir al carrito</a>
          </div>
          <div class="pc-info">
            <div class="pc-brand">{{ block.settings.brand }}</div>
            <div class="pc-name">{{ block.settings.product_name }}</div>
            <div class="pc-price">
              <span class="pp-cur">{{ block.settings.price }}</span>
              {% if block.settings.old_price != blank %}
                <span class="pp-old">{{ block.settings.old_price }}</span>
                <span class="pp-save">{{ block.settings.discount }}</span>
              {% endif %}
            </div>
            <div class="pc-stars">{{ block.settings.stars }} <span>({{ block.settings.reviews }} reseñas)</span></div>
          </div>
        </div>
      {% endfor %}
    </div>
    <div style="text-align:center;margin-top:44px">
      <a href="{{ routes.collections_url }}" class="btn btn-o">Ver todos los productos &#x1F43E;</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Productos destacados",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji del producto",
          "default": "🐕"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (dejar vacio para ocultar)",
          "default": ""
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Color del badge",
          "options": [
            { "value": "b-new", "label": "Verde" },
            { "value": "b-hot", "label": "Naranja" },
            { "value": "b-sale", "label": "Rosa" }
          ],
          "default": "b-new"
        },
        {
          "type": "text",
          "id": "brand",
          "label": "Categoria",
          "default": "Perros"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Nombre del producto",
          "default": "Nombre del producto"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio actual",
          "default": "9,99"
        },
        {
          "type": "text",
          "id": "old_price",
          "label": "Precio anterior (opcional)",
          "default": ""
        },
        {
          "type": "text",
          "id": "discount",
          "label": "Descuento ej: -30%",
          "default": ""
        },
        {
          "type": "text",
          "id": "stars",
          "label": "Estrellas",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "reviews",
          "label": "Numero de resenas",
          "default": "100"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Enlace al producto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Productos destacados"
    }
  ]
}
{% endschema %}
