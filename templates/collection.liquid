{% section 'header' %}

<div style="background:var(--cream);min-height:60vh">
  <div class="sec">
    <div class="sec-lbl">{{ collection.title }}</div>
    <h1 class="sec-h">{{ collection.title }}</h1>

    {% if collection.products_count == 0 %}
      <p style="color:var(--gray);font-size:15px;text-align:center;padding:60px 0">
        No hay productos en esta colección todavía.
      </p>
    {% else %}
      <div class="prod-grid">
        {% for product in collection.products %}
          <div class="pc">
            <a href="{{ product.url }}" style="display:block;text-decoration:none">
              <div class="pc-img">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '400x400' }}" alt="{{ product.title }}" style="width:100%;height:100%;object-fit:cover">
                {% else %}
                  🐾
                {% endif %}
              </div>
              <div class="pc-info">
                <div class="pc-brand">{{ product.type }}</div>
                <div class="pc-name">{{ product.title }}</div>
                <div class="pc-price">
                  <span class="pp-cur">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="pp-old">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% section 'footer' %}
